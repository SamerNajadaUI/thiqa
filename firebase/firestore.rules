rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // كل لاعب بيقرأ ويكتب مستنده بس. ما بنقبل خطة أدمن من العميل، وزيادة النقاط لكل كتابة محدودة.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.plan in ['free', 'plus_m', 'plus_y']
        && request.resource.data.points is number && request.resource.data.points <= 100;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.plan in ['free', 'plus_m', 'plus_y']
        && request.resource.data.points is number
        && request.resource.data.points >= resource.data.points
        && request.resource.data.points <= resource.data.points + 500;
    }
  }
}
